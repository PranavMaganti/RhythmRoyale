{
  "name": "rhythm-royale",
  "description": "Rhythm based battle royale game.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rhythm-royale/backend --filter @rhythm-royale/frontend dev",
    "build": "pnpm --recursive build",
    "build:offline": "pnpm --filter @rhythm-royale/frontend build:offline",
    "start": "pnpm --filter @rhythm-royale/backend start",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelClasby0/RhythmRoyale.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}
